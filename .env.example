# ──────────────────────────────────────────────
# VeriCoach — environment variables template
# Copy to .env and fill in real values.
# NEVER commit the real .env file.
# ──────────────────────────────────────────────

# ── LLM Provider ──────────────────────────────
# Options: gemini | mock | ollama
LLM_PROVIDER=gemini

# Google Gemini (default provider)
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Ollama (optional, local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── API Security & Auth ────────────────────────
# Comma-separated or JSON list of accepted X-API-Key values
API_KEYS=["vc-dev-key-12345","vc-test-key-67890"]
REQUIRE_API_KEY=false

# ── Rate Limiting ──────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── App settings ──────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
DEFAULT_LOCALE=en

# ── RAG & Chroma ─────────────────────────────
CHROMA_PERSIST_DIRECTORY=
RAG_TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ── Ragas Evaluation ─────────────────────────
EVAL_PROVIDER=mock
RAGAS_JUDGE_MODEL=gemini-1.5-flash
RAGAS_EMBEDDING_MODEL=text-embedding-004
RAGAS_CACHE_DIR=.cache/ragas_judge
RAGAS_OUTPUT_DIR=results

# ── DeepEval Evaluation ───────────────────────
DEEPEVAL_JUDGE_MODEL=gemini-1.5-flash
DEEPEVAL_GATES_PATH=qa/config/gates.yaml
DEEPEVAL_OUTPUT_DIR=results
DEEPEVAL_TELEMETRY_OPT_OUT=YES

# ── Security & Promptfoo Evaluation ───────────
ENABLE_POISONED_CORPUS=false
PROMPTFOO_CONFIG_DIR=qa/.promptfoo
PROMPTFOO_CACHE_DIR=qa/.promptfoo/cache
PROMPTFOO_DISABLE_TELEMETRY=true
