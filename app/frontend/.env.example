# VeriCoach Frontend Environment Variables

# Backend API base URL (leave empty in Vite dev mode to use dev proxy, or configure explicitly)
# Web desktop default: http://localhost:8000
# Android emulator default: http://10.0.2.2:8000
VITE_API_BASE_URL=http://localhost:8000

# Optional API key for backend authentication (if backend require_api_key=true)
VITE_API_KEY=vc-dev-key-12345
