# Test Automation Framework Environment Variables
TEST_PROFILE=local
TEST_BASE_URL=http://localhost:8000
TEST_HEADLESS=true
TEST_BROWSER=chromium
TEST_RETRY_COUNT=1
TEST_RETRY_DELAY=1
TEST_PARALLEL_WORKERS=auto
TEST_ALLURE_RESULTS_DIR=qa/allure-results
TEST_TRIAGE_FILE=qa/triage.json

# LLM Provider Configuration
LLM_PROVIDER=mock
GOOGLE_API_KEY=mock-google-key-for-testing
